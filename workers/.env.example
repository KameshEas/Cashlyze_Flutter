# Example environment variables for Cashlyze Cloudflare Worker
# ──────────────────────────────────────────────────────────────────────────────
# DO NOT commit real secrets.
# Set secrets via the Wrangler CLI:
#
#   npx wrangler secret put RESEND_API_KEY
#   npx wrangler secret put OTP_SECRET
#   npx wrangler secret put FIREBASE_SERVICE_ACCOUNT
#
# Non-secret vars can live in wrangler.toml [vars] or be set with:
#   npx wrangler secret put FROM_EMAIL
# ──────────────────────────────────────────────────────────────────────────────

# Your Resend API key (https://resend.com)
RESEND_API_KEY=

# Secret salt used to hash OTPs before storing in Firestore
OTP_SECRET=

# Full JSON content of your Firebase service-account key file (single-line string)
FIREBASE_SERVICE_ACCOUNT=

# The "from" email address verified with Resend (optional)
FROM_EMAIL=Cashlyze <noreply@aspired2d.cloud>

# CORS allowed origin — your Cloudflare Pages URL or custom domain
ALLOWED_ORIGIN=https://cashlyze-flutter.pages.dev

# Set to "true" ONLY in dev/staging to return the raw OTP in the response
DEV_RETURN_OTP=false
