# Example environment variables for web/api/send-otp
# Do NOT commit your real API key into source control.
# Set these in your Netlify/Vercel/hosting provider environment variables.

# Your Resend API key
RESEND_API_KEY=

# Optional: the "from" email address verified with Resend
FROM_EMAIL=onboarding@resend.dev

# Allowed origin for CORS (defaults to https://cashlyze.netlify.app)
ALLOWED_ORIGIN=https://cashlyze.netlify.app

# Optional: Resend template ID for the OTP email (see docs/email-templates/otp-verification.txt)
# When set, the template is used instead of the inline plain-text fallback.
RESEND_TEMPLATE_ID=
