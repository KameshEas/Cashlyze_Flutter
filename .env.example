# Firebase Configuration
FIREBASE_API_KEY=your_api_key_here
FIREBASE_APP_ID=your_app_id_here
FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_STORAGE_BUCKET=your_storage_bucket_here

# Encryption
# 32-character random string for local encryption (if not using generated key)
ENCRYPTION_KEY=your_encryption_key_here

# API Keys
# Add other API keys here

# On-device AI (Gemma model download from HuggingFace)
# litert-community/Gemma3-1B-IT is a gated model - create a read token at
# https://huggingface.co/settings/tokens and accept the model's terms at
# https://huggingface.co/litert-community/Gemma3-1B-IT before it will work.
HUGGINGFACE_TOKEN=your_huggingface_token_here

# OneSignal App ID (push notifications). Set it in your pipeline's secrets so the
# build's .env contains it; leave it empty locally to run without push. A build
# without it skips OneSignal, and its devices never appear in Aspire Helm.
ONESIGNAL_APP_ID=
